# Maintainer: Amphero <301399868+Amphero@users.noreply.github.com>
pkgbase=networkmanager-tailscale
pkgname=(networkmanager-tailscale networkmanager-tailscale-plasma)
pkgver=0.1.6
pkgrel=1
_plasmanm_ver=6.8.3
pkgdesc="NetworkManager VPN plugin for Tailscale"
arch=(x86_64)
url="https://github.com/Amphero/networkmanager-tailscale"
license=(GPL-2.0-or-later)
options=(!debug)
makedepends=(gcc make pkgconf glib2-devel libnm gtk3 gtk4 json-glib curl qt6-base
             plasma-nm kcoreaddons kwidgetsaddons networkmanager-qt)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "plasma-nm-v$_plasmanm_ver.tar.gz::https://invent.kde.org/plasma/plasma-nm/-/archive/v$_plasmanm_ver/plasma-nm-v$_plasmanm_ver.tar.gz"
        networkmanager-tailscale-plasma.hook)
sha256sums=('bb292bfe5a2c3a5e3d90921248864db1480c22072b759da3112244b74ed61041'
            '63238776b672248c3131570ffdfca6d44def24f998426c323c4002fbf2246912'
            '69e523bae84d0c04debcc25d345ae0c52d478072ba39fdbb76f59d390ccaf6d5')

prepare() {
	cd "$pkgbase-$pkgver"
	mkdir -p reference
	ln -sfn "$srcdir/plasma-nm-v$_plasmanm_ver" reference/plasma-nm
}

build() {
	cd "$pkgbase-$pkgver"
	make -f build.mk all
}

package_networkmanager-tailscale() {
	pkgdesc+=" (service daemon and GTK editors)"
	depends=(networkmanager libnm curl json-glib tailscale)
	optdepends=('gtk3: editor for nm-connection-editor'
	            'gtk4: editor for GNOME Settings')

	cd "$pkgbase-$pkgver"
	make -f build.mk DESTDIR="$pkgdir" install-core
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_networkmanager-tailscale-plasma() {
	pkgdesc+=" (plasma-nm integration; rebuild after plasma-nm updates)"
	depends=(networkmanager-tailscale plasma-nm)

	cd "$pkgbase-$pkgver"
	make -f build.mk DESTDIR="$pkgdir" install-plasma
	install -Dm644 "$srcdir/networkmanager-tailscale-plasma.hook" \
		"$pkgdir/usr/share/libalpm/hooks/networkmanager-tailscale-plasma.hook"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
