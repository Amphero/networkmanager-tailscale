[Trigger]
Operation = Upgrade
Type = Package
Target = plasma-nm

[Action]
Description = networkmanager-tailscale-plasma: plasma-nm was updated
When = PostTransaction
Exec = /usr/bin/echo "==> networkmanager-tailscale-plasma was built against the previous plasma-nm version. Rebuild it (make pkg) and install it with pacman -U, otherwise the Plasma settings dialog may fail to load (the network applet keeps working)."
