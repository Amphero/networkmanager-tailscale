[VPN Connection]
name=tailscale
service=org.freedesktop.NetworkManager.tailscale
program=@NM_LIBEXECDIR@/nm-tailscale-service
supports-multiple-connections=false
supports-safe-private-file-access=true

[libnm]
plugin=@NM_PLUGINDIR@/libnm-vpn-plugin-tailscale.so

[GNOME]
supports-external-ui-mode=false
supports-hints=false
